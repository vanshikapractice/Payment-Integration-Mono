generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments  Payment[]

  @@map("users")
}

model Payment {
  id             String        @id @default(cuid())
  providerOrderId String       @unique
  amount         Int
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("mock")
  description    String?
  userId         String
  // Financial records are retained: deleting a user is
  // restricted while they still have payments, so payment
  // history is never removed as a side effect of a user
  // delete. An explicit retention policy is required before
  // any financial record may be purged.
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}

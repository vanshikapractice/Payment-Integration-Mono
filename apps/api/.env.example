# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database
DATABASE_URL="mysql://root:password@localhost:3306/payment_db?schema=public"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Security
# Strong, unique secret used to sign authentication tokens (JWT, HS256).
# Required in production; a development-only fallback is used when unset.
# JWT_SECRET=change-me-to-a-long-random-secret

# Payment
# Mock mode must be explicitly enabled and is always disabled in production.
PAYMENT_MOCK_MODE=true
PAYMENT_PROVIDER=mock
# Comma-separated allowlist of test amounts in minor units (e.g., cents)
PAYMENT_ALLOWED_AMOUNTS=1000,2500,5000,10000
PAYMENT_CURRENCY=USD
